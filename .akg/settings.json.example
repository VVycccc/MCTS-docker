{
  "_comment": "Copy to settings.json and fill in your API keys. DO NOT commit settings.json.",
  "_comment2": "AKG reads AIKG_* / AKG_AGENTS_* env vars first, then .akg/settings.json as fallback.",
  "models": {
    "standard": {
      "provider_type": "openai",
      "model_name": "deepseek-v4-pro",
      "base_url": "https://api.deepseek.com/v1",
      "api_key": "YOUR_API_KEY_HERE",
      "temperature": 0.7,
      "max_tokens": 65536,
      "timeout": 600
    },
    "fast": {
      "provider_type": "openai",
      "model_name": "deepseek-v4-pro",
      "base_url": "https://api.deepseek.com/v1",
      "api_key": "YOUR_API_KEY_HERE",
      "temperature": 0.3,
      "max_tokens": 65536,
      "timeout": 600
    },
    "complex": {
      "provider_type": "openai",
      "model_name": "deepseek-v4-pro",
      "base_url": "https://api.deepseek.com/v1",
      "api_key": "YOUR_API_KEY_HERE",
      "temperature": 0.7,
      "max_tokens": 65536,
      "timeout": 600
    }
  },
  "default_model": "standard"
}
